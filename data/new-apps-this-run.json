      "flow": {
        "triggers": [
          {
            "id": "filter_cleaning_due",
            "title": {
              "en": "The filter needs cleaning",
              "da": "Filteret skal renses"
            },
            "hint": {
              "en": "Triggers once when weighted fan use reaches the cleaning interval. Also triggers if the interval is lowered to or below accumulated use. Reset after cleaning to start again.",
              "da": "Udløses én gang, når den vægtede ventilatortid når renseintervallet. Udløses også, hvis intervallet sænkes til eller under den optjente tid. Nulstil efter rensning for at starte forfra."
            },
            "args": [
              {
                "type": "device",
                "name": "device",
                "filter": "driver_id=thermex_hood"
              }
            ]
          },
          {
            "id": "light_on_for",
            "title": {
              "en": "The light has been on for a duration",
              "da": "Lyset har været tændt i et tidsrum"
            },
            "titleFormatted": {
              "en": "The light has been on for [[duration]] [[unit]]",
              "da": "Lyset har været tændt i [[duration]] [[unit]]"
            },
            "hint": {
              "en": "Triggers once after the light stays on for this duration. Turning it off resets the timer.",
              "da": "Udløses én gang, når lyset har været tændt i dette tidsrum. Når lyset slukkes, nulstilles timeren."
            },
            "args": [
              {
                "type": "device",
                "name": "device",
                "filter": "driver_id=thermex_hood"
              },
              {
                "name": "duration",
                "type": "number",
                "title": {
                  "en": "Duration",
                  "da": "Varighed"
                },
                "min": 1,
                "step": 1,
                "placeholder": {
                  "en": "Duration",
                  "da": "Varighed"
                }
              },
              {
                "name": "unit",
                "type": "dropdown",
                "title": {
                  "en": "Unit",
                  "da": "Enhed"
                },
                "values": [
                  {
                    "id": "seconds",
                    "label": {
                      "en": "seconds",
                      "da": "sekunder"
                    }
                  },
                  {
                    "id": "minutes",
                    "label": {
                      "en": "minutes",
                      "da": "minutter"
                    }
                  }
                ]
              }
            ]
          },
          {
            "id": "fan_on_for",
            "title": {
              "en": "The fan has been on for a duration",
              "da": "Ventilatoren har været tændt i et tidsrum"
            },
            "titleFormatted": {
              "en": "The fan has been on for [[duration]] [[unit]]",
              "da": "Ventilatoren har været tændt i [[duration]] [[unit]]"
            },
            "hint": {
              "en": "Triggers once after the fan stays on for this duration. Turning it off resets the timer.",
              "da": "Udløses én gang, når ventilatoren har været tændt i dette tidsrum. Når ventilatoren slukkes, nulstilles timeren."
            },
            "args": [
              {
                "type": "device",
                "name": "device",
                "filter": "driver_id=thermex_hood"
              },
              {
                "name": "duration",
                "type": "number",
                "title": {
                  "en": "Duration",
                  "da": "Varighed"
                },
                "min": 1,
                "step": 1,
                "placeholder": {
                  "en": "Duration",
                  "da": "Varighed"
                }
              },
              {
                "name": "unit",
                "type": "dropdown",
                "title": {
                  "en": "Unit",
                  "da": "Enhed"
                },
                "values": [
                  {
                    "id": "seconds",
                    "label": {
                      "en": "seconds",
                      "da": "sekunder"
                    }
