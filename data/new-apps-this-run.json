  {
    "id": "nl.lrvdlinden.nlalert-widget",
    "rating": null,
    "liveBuild": {
      "id": 24,
      "name": {
        "en": "NL-Alert",
        "nl": "NL-Alert"
      },
      "version": "1.0.4",
      "readme": {
        "en": "NL-Alert is the emergency warning system of the Dutch government. During a disaster, serious incident or crisis, the authorities determine the area in which an NL-Alert is broadcast. With NL-Alert for Homey, active alerts are also available in Homey. The app uses your configured Homey location and displays current warnings through Dashboard widgets, including a map view.\n\nImportant: this app is an independent Homey integration and should never be relied upon as the sole source of emergency information. Always follow official channels, including NL-Alert on your phone, public warning sirens and information from the Dutch government.\n",
        "nl": "NL-Alert is het alarmmiddel van de Nederlandse overheid. Tijdens een ramp, ernstig incident of crisis bepaalt de overheid in welk gebied een NL-Alert wordt uitgezonden. Met NL-Alert voor Homey ontvang je actieve NL-Alerts ook in Homey. De app gebruikt de ingestelde locatie van je Homey en maakt actuele waarschuwingen zichtbaar via de Dashboard-widgets, waaronder een kaartweergave.\n\nBelangrijk: deze app is een onafhankelijke Homey-integratie en mag bij een noodsituatie nooit als enige waarschuwingsbron worden gebruikt. Vertrouw altijd op de officiële kanalen, zoals NL-Alert op je telefoon, de sirenes en informatie van de Nederlandse overheid.\n"
      },
      "description": {
        "en": "Stay informed when an NL-Alert affects your area.",
        "nl": "Blijf op de hoogte wanneer een NL-Alert voor jouw omgeving geldt."
      },
      "category": "security",
      "brandColor": "#000000",
      "icon": "https://apps.homeycdn.net/app/nl.lrvdlinden.nlalert-widget/24/5bf7fbe9-5419-4cab-9349-5600ce5c1f6a/assets/icon.svg",
      "imageSmall": "https://apps.homeycdn.net/app/nl.lrvdlinden.nlalert-widget/24/5bf7fbe9-5419-4cab-9349-5600ce5c1f6a/assets/images/small.png",
      "imageLarge": "https://apps.homeycdn.net/app/nl.lrvdlinden.nlalert-widget/24/5bf7fbe9-5419-4cab-9349-5600ce5c1f6a/assets/images/large.png",
      "drivers": null,
      "flow": {
        "triggers": [
          {
            "id": "alert_received",
            "title": {
              "en": "NL Alert received",
              "nl": "NL Alert ontvangen"
            },
            "titleFormatted": {
              "en": "A new emergency alert is active in your area",
              "nl": "Er is een nieuwe noodmelding actief in jouw omgeving"
            },
            "hint": {
              "en": "Triggers whenever a newly issued NL-Alert applies to the current Homey location.",
              "nl": "Wordt geactiveerd zodra een nieuw NL-Alert van toepassing is op de huidige locatie van Homey."
            },
            "tokens": [
              {
                "name": "alert_id",
                "type": "string",
                "title": {
                  "en": "Alert ID",
                  "nl": "Alert-ID"
                }
              },
              {
                "name": "alert_message",
                "type": "string",
                "title": {
                  "en": "Alert message",
                  "nl": "Alertbericht"
                }
              },
              {
                "name": "alert_start_at",
                "type": "string",
                "title": {
                  "en": "Start time",
                  "nl": "Starttijd"
                }
              },
              {
                "name": "alert_stop_at",
                "type": "string",
                "title": {
                  "en": "End time",
                  "nl": "Eindtijd"
                }
              }
            ],
            "platforms": [
              "local",
              "cloud"
            ]
          }
        ],
        "conditions": [
          {
            "id": "alert_active",
            "title": {
              "en": "An NL Alert is active",
              "nl": "Er is een actieve NL Alert"
            },
            "titleFormatted": {
              "en": "!{{An emergency alert is currently active in your area|There are currently no active emergency alerts in your area}}",
              "nl": "!{{Er is momenteel een noodmelding actief in jouw omgeving|Er zijn momenteel geen actieve noodmeldingen in jouw omgeving}}"
            },
            "hint": {
              "en": "Checks whether an active NL-Alert currently applies to the Homey location.",
              "nl": "Controleert of er op dit moment een actief NL-Alert geldt voor de locatie van Homey."
            },
            "platforms": [
              "local",
              "cloud"
            ]
          }
        ],
        "actions": [
          {
            "id": "get_alerts",
            "title": {
              "en": "Get active NL Alerts",
              "nl": "Haal actieve NL Alerts op"
            },
            "titleFormatted": {
              "en": "Get all active NL Alerts for your location",
              "nl": "Haal alle actieve NL Alerts op voor jouw locatie"
            },
            "hint": {
              "en": "Retrieves all currently active NL Alerts affecting your Homey's location.",
              "nl": "Haalt alle momenteel actieve NL Alerts op die invloed hebben op de locatie van jouw Homey."
            },
            "tokens": [
              {
                "name": "count",
                "type": "number",
                "title": {
                  "en": "Number of alerts",
                  "nl": "Aantal alerts"
                }
              },
              {
                "name": "first_message",
                "type": "string",
                "title": {
                  "en": "First alert message",
                  "nl": "Eerste alertbericht"
                }
              },
              {
                "name": "alerts_json",
                "type": "string",
                "title": {
                  "en": "Alerts (JSON)",
                  "nl": "Alerts (JSON)"
                }
              }
            ],
            "platforms": [
              "local",
              "cloud"
            ]
          }
        ]
      },
      "widgets": {
        "nlalert-map": {
