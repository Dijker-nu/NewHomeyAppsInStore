                "name": "device",
                "type": "device",
                "filter": "driver_id=smartmeter"
              }
            ],
            "tokens": [
              {
                "name": "kwh",
                "type": "number",
                "title": {
                  "en": "kWh",
                  "de": "kWh"
                },
                "example": {
