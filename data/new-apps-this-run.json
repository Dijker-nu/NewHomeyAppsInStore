      "flow": {
        "triggers": [
          {
            "id": "changed_externally",
            "title": {
              "en": "Was switched outside Homey",
              "nl": "Is buiten Homey om bediend"
            },
            "hint": {
              "en": "With the Häfele app, a remote or a wall switch. Only seen while Homey is connected to the mesh.",
              "nl": "Met de Häfele-app, een afstandsbediening of een wandschakelaar. Alleen zichtbaar terwijl Homey met het mesh verbonden is."
            },
            "args": [
