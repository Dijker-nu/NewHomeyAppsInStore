  {
    "id": "com.wisse.ocppbridge",
    "rating": null,
    "liveBuild": {
      "id": 1,
      "name": {
        "en": "OCPP Bridge"
      },
      "version": "1.0.1",
      "readme": {
        "en": "OCPP Bridge makes Homey the place where your electric car charges smartly. Your home charger connects straight to Homey over your own network, so you can see what it is doing at a glance and let your Flows decide when and how fast to charge, for example on cheap hours or on your own solar power.\n\nMost home chargers are also linked to a charging provider for invoices, charge cards or an app. With OCPP Bridge that link stays intact: Homey sits in the middle and passes everything on, so your provider keeps working exactly as before, and the app quietly repairs the connection when it drops. Setup takes a few minutes and needs no technical knowledge: Homey shows the address to enter in your charger and finds the charger by itself. You need a Homey Pro and a charger that supports OCPP 1.6 (JSON), which most modern wallboxes do.\n"
      },
      "description": {
        "en": "Smart charging from Homey, with your charging provider still on board."
      },
      "category": "energy",
      "brandColor": "#0F766E",
      "icon": "https://apps.homeycdn.net/app/com.wisse.ocppbridge/1/c9ef16cd-854f-4e14-be6b-f4410a8a3c3c/assets/icon.svg",
      "imageSmall": "https://apps.homeycdn.net/app/com.wisse.ocppbridge/1/c9ef16cd-854f-4e14-be6b-f4410a8a3c3c/assets/images/small.png",
      "imageLarge": "https://apps.homeycdn.net/app/com.wisse.ocppbridge/1/c9ef16cd-854f-4e14-be6b-f4410a8a3c3c/assets/images/large.png",
      "drivers": [
        {
          "id": "charger",
          "name": {
            "en": "EV charger"
          },
          "class": "evcharger",
          "capabilities": [
            "onoff",
            "measure_power",
            "meter_power",
            "measure_current",
            "measure_voltage",
            "charging_status",
            "alarm_generic"
          ],
          "capabilitiesOptions": {
            "onoff": {
              "title": {
                "en": "Charging"
              }
            },
            "alarm_generic": {
              "title": {
                "en": "Connection problem"
              }
            }
          },
          "energy": {
            "evCharger": true,
            "meterPowerImportedCapability": "meter_power"
          },
          "imageSmall": "https://apps.homeycdn.net/app/com.wisse.ocppbridge/1/c9ef16cd-854f-4e14-be6b-f4410a8a3c3c/drivers/charger/assets/images/small.png",
          "imageLarge": "https://apps.homeycdn.net/app/com.wisse.ocppbridge/1/c9ef16cd-854f-4e14-be6b-f4410a8a3c3c/drivers/charger/assets/images/large.png",
          "platforms": [
            "local"
          ],
          "connectivity": [
            "lan"
          ],
          "icon": "https://apps.homeycdn.net/app/com.wisse.ocppbridge/1/c9ef16cd-854f-4e14-be6b-f4410a8a3c3c/drivers/charger/assets/icon.svg"
        }
      ],
      "flow": {
        "triggers": [
          {
            "id": "connection_alert",
            "title": {
              "en": "Connection alert"
            },
            "hint": {
              "en": "Fires when the charging provider or charger connection has been down for a while, was restored automatically, or could not be restored. Use the message tag in a Flow that sends a push notification."
            },
            "tokens": [
              {
                "name": "kind",
                "type": "string",
                "title": {
                  "en": "Type"
                },
                "example": "problem"
              },
              {
                "name": "message",
                "type": "string",
                "title": {
                  "en": "Message"
                },
                "example": {
                  "en": "The connection to your charging provider is back after 3 min."
                }
              }
            ]
          },
          {
            "id": "charging_started",
            "title": {
              "en": "Charging started"
            },
            "args": [
              {
                "type": "device",
                "name": "device",
                "filter": "driver_id=charger"
              }
            ]
          },
          {
            "id": "charging_stopped",
            "title": {
              "en": "Charging stopped"
            },
            "args": [
              {
                "type": "device",
                "name": "device",
                "filter": "driver_id=charger"
              }
            ]
          },
          {
            "id": "vehicle_connected",
            "title": {
              "en": "A car was plugged in"
            },
            "args": [
              {
                "type": "device",
                "name": "device",
                "filter": "driver_id=charger"
              }
            ]
          },
          {
            "id": "vehicle_disconnected",
            "title": {
              "en": "The car was unplugged"
            },
            "args": [
              {
                "type": "device",
                "name": "device",
                "filter": "driver_id=charger"
              }
            ]
          },
          {
            "id": "connection_lost",
            "title": {
              "en": "Charger connection lost"
            },
            "hint": {
              "en": "The charger lost its connection to Homey, for example because of a power cut or wifi problem."
            },
            "args": [
              {
                "type": "device",
                "name": "device",
                "filter": "driver_id=charger"
              }
            ],
            "tokens": [
              {
                "name": "reason",
                "type": "string",
                "title": {
                  "en": "Reason"
                },
                "example": {
                  "en": "The charger is not connected to Homey."
                }
              }
            ]
          },
          {
            "id": "connection_restored",
            "title": {
              "en": "Charger connection restored"
            },
            "args": [
              {
                "type": "device",
                "name": "device",
                "filter": "driver_id=charger"
              }
            ]
          }
        ],
        "conditions": [
          {
            "id": "is_charging",
            "title": {
              "en": "Charger !{{is|isn't}} charging"
            },
            "args": [
              {
                "type": "device",
                "name": "device",
                "filter": "driver_id=charger"
              }
            ]
          },
          {
            "id": "backoffice_connected",
            "title": {
              "en": "Charging provider !{{is|isn't}} connected"
            },
            "hint": {
              "en": "Whether Homey currently has a working connection to the charging provider set for this charger."
            },
            "args": [
              {
                "type": "device",
                "name": "device",
                "filter": "driver_id=charger"
              }
            ]
          }
        ],
        "actions": [
          {
            "id": "start_charging",
            "title": {
              "en": "Start charging"
            },
            "hint": {
              "en": "A car must be plugged in."
            },
            "args": [
              {
                "type": "device",
                "name": "device",
                "filter": "driver_id=charger"
              }
            ]
          },
          {
            "id": "stop_charging",
            "title": {
              "en": "Stop charging"
            },
            "args": [
              {
                "type": "device",
                "name": "device",
                "filter": "driver_id=charger"
              }
            ]
          },
          {
            "id": "set_charging_current_limit",
            "title": {
              "en": "Set maximum charging current"
            },
            "titleFormatted": {
              "en": "Set maximum charging current to [[amps]] A"
            },
            "hint": {
              "en": "Limits how fast the car charges, for example to match solar surplus. The value is kept between the lowest and highest current set in the device settings; a charger cannot charge slower than its lowest step."
            },
            "args": [
              {
                "type": "device",
                "name": "device",
                "filter": "driver_id=charger"
              },
              {
                "type": "number",
                "name": "amps",
                "title": {
                  "en": "Amps"
                },
                "min": 1,
                "max": 80,
                "step": 1,
                "placeholder": {
                  "en": "16"
                }
              }
            ]
          }
        ]
      },
