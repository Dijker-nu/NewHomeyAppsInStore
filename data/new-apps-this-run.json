  {
    "id": "com.github.moogblob.commodore",
    "rating": null,
    "liveBuild": {
      "id": 5,
      "name": {
        "en": "Commodore"
      },
      "version": "1.1.2",
      "readme": {
        "en": "Control your C64 Ultimate from Homey over the local network.\n\n- See when the C64 Ultimate is turned on or off, and use it to trigger Flows\n- Reset, reboot, pause or power off the machine, or press the menu button\n- Run programs and cartridges, play SID and MOD tunes, and mount disk images, picked from the files on the machine's storage\n- Find SID tunes by name, title, composer or year\n- SID Jukebox widget for the dashboard: search, play or pick a random tune\n- See which disk image is mounted in drive A\n\nRequirements: Web Remote Control Service and FTP File Service enabled in the network settings of the C64 Ultimate menu. Tested with C64 Ultimate firmware 1.1.0.\n\nThis app is not affiliated with Commodore.\n"
      },
      "description": {
        "en": "Bring the breadbin home"
      },
      "category": "appliances",
      "brandColor": "#4040E0",
      "icon": "https://apps.homeycdn.net/app/com.github.moogblob.commodore/5/06bced25-652c-423a-8f47-6024722f8f01/assets/icon.svg",
      "imageSmall": "https://apps.homeycdn.net/app/com.github.moogblob.commodore/5/06bced25-652c-423a-8f47-6024722f8f01/assets/images/small.png",
      "imageLarge": "https://apps.homeycdn.net/app/com.github.moogblob.commodore/5/06bced25-652c-423a-8f47-6024722f8f01/assets/images/large.png",
      "drivers": [
        {
          "id": "ultimate",
          "name": {
            "en": "C64 Ultimate"
          },
          "class": "other",
          "capabilities": [
            "ultimate_on",
            "measure_power",
            "ultimate_drive_a",
            "volume_set",
            "volume_mute",
            "button.reset",
            "button.reboot",
            "button.menu",
            "button.poweroff",
            "button.scan"
          ],
          "capabilitiesOptions": {
            "button.reset": {
              "title": {
                "en": "Reset"
              }
            },
            "button.reboot": {
              "title": {
                "en": "Reboot"
              },
              "maintenanceAction": true
            },
            "button.menu": {
              "title": {
                "en": "Menu button"
              }
            },
            "button.scan": {
              "title": {
                "en": "Scan storage"
              },
              "maintenanceAction": true
            },
            "button.poweroff": {
              "title": {
                "en": "Power off"
              }
            },
            "measure_power": {
              "approximated": true
            }
          },
          "imageSmall": "https://apps.homeycdn.net/app/com.github.moogblob.commodore/5/06bced25-652c-423a-8f47-6024722f8f01/drivers/ultimate/assets/images/small.png",
          "imageLarge": "https://apps.homeycdn.net/app/com.github.moogblob.commodore/5/06bced25-652c-423a-8f47-6024722f8f01/drivers/ultimate/assets/images/large.png",
          "platforms": [
            "local"
          ],
          "connectivity": [
            "lan"
          ],
          "icon": "https://apps.homeycdn.net/app/com.github.moogblob.commodore/5/06bced25-652c-423a-8f47-6024722f8f01/drivers/ultimate/assets/icon.svg"
        }
      ],
      "flow": {
        "triggers": [
          {
            "id": "turned_on",
            "title": {
              "en": "Turned on"
            },
            "hint": {
              "en": "Fires when the C64 Ultimate starts answering on the network, usually within 15 seconds."
            },
            "args": [
              {
                "type": "device",
                "name": "device",
                "filter": "driver_id=ultimate"
              }
            ]
          },
          {
            "id": "turned_off",
            "title": {
              "en": "Turned off"
            },
            "hint": {
              "en": "Fires when the C64 Ultimate stops answering on the network, usually within 35 seconds."
            },
            "args": [
              {
                "type": "device",
                "name": "device",
                "filter": "driver_id=ultimate"
              }
            ]
          }
        ],
        "conditions": [
          {
            "id": "is_on",
            "title": {
              "en": "Is !{{on|off}}"
            },
            "args": [
              {
                "type": "device",
                "name": "device",
                "filter": "driver_id=ultimate"
              }
            ]
          },
          {
            "id": "disk_mounted",
            "title": {
              "en": "A disk !{{is|isn't}} mounted in drive"
            },
            "titleFormatted": {
              "en": "A disk !{{is|isn't}} mounted in drive [[drive]]"
            },
            "args": [
              {
                "type": "device",
                "name": "device",
                "filter": "driver_id=ultimate"
              },
              {
                "name": "drive",
                "type": "dropdown",
                "values": [
                  {
                    "id": "a",
                    "label": {
                      "en": "A"
                    }
                  },
                  {
                    "id": "b",
                    "label": {
                      "en": "B"
                    }
                  }
                ]
              }
            ]
          }
        ],
        "actions": [
