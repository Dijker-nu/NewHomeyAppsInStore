[
  {
    "id": "dk.hye-knudsen.thermexwifihood",
    "rating": null,
    "liveBuild": {
      "id": 4,
      "name": {
        "en": "Thermex",
        "da": "Thermex"
      },
      "version": "1.1.0",
      "readme": {
        "en": "Control your Thermex WiFi enabled extractor hood.\r\n\r\nFirst set up the hood in the official Thermex app for your phone. There should be a setting for WiFi and a setting for Smart Home\", where you can set up a password.\r\n\r\nWhen adding a hood in Homey, first enter its local IPv4 address and hood password on the connection screen. The password input is masked. Select the hood on the next screen to add it; these values are saved in Advanced settings and used when connecting to the hood.\r\n\r\nThe device has two independent sliders for light brightness and fan speed and hopefully will get more features as development progresses and you suggestion come in.",
        "da": "Styr din Thermex-emhætte med WiFi.\n\nOpsæt først emhætten i den officielle Thermex-app på din telefon. Der bør være en indstilling for WiFi og en indstilling for \"Smart Home\", hvor du kan oprette en adgangskode.\n\nNår du tilføjer en emhætte i Homey, skal du først indtaste dens lokale IPv4-adresse og adgangskode på tilslutningsskærmen. Adgangskoden skjules under indtastning. Vælg emhætten på den næste skærm for at tilføje den.\n\nEnheden har to uafhængige skydere til lysstyrke og ventilatorhastighed, men jeg håber at kunne tilføje flere features efterhånden. Kom gerne med forslag."
      },
      "description": {
        "en": "Kitchen extractor hoods since 1958",
        "da": "Køkkenventilation siden 1958"
      },
      "category": "appliances",
      "brandColor": "#212121",
      "icon": "https://apps.homeycdn.net/app/dk.hye-knudsen.thermexwifihood/4/8bd93005-e897-4185-9dff-572aadf174f9/assets/icon.svg",
      "imageSmall": "https://apps.homeycdn.net/app/dk.hye-knudsen.thermexwifihood/4/8bd93005-e897-4185-9dff-572aadf174f9/assets/images/small.png",
      "imageLarge": "https://apps.homeycdn.net/app/dk.hye-knudsen.thermexwifihood/4/8bd93005-e897-4185-9dff-572aadf174f9/assets/images/large.png",
      "drivers": [
        {
          "id": "thermex_hood",
          "name": {
            "en": "Thermex Hood",
            "da": "Thermex-emhætte"
          },
          "class": "other",
          "capabilities": [
            "dim.light",
            "fan_speed.fan",
            "fan_speed.history",
            "light_mode.brightness",
            "hood_light_on",
            "hood_fan_on",
            "measure_hood_light_status",
            "measure_hood_fan_status"
          ],
          "capabilitiesOptions": {
