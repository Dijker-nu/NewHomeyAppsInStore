  {
    "id": "com.drchip666.mqttbridge",
    "rating": null,
    "liveBuild": {
      "id": 5,
      "name": {
        "en": "MQTT Bridge",
        "da": "MQTT Bro"
      },
      "version": "1.0.1",
      "readme": {
        "en": "MQTT Bridge quietly mirrors messages between two MQTT brokers, so devices and services that live outside the Homey ecosystem, such as a solar inverter monitor, can talk to your Flows in real time. Messages travel in both directions using topic rules you set yourself, so only the data you care about crosses over, and a built-in safeguard keeps the two brokers from talking over each other in an endless loop.\n\nOnce connected, values published on the other broker instantly become available to Homey Flows, and Flows can publish values straight back, so your energy monitor or other MQTT-enabled equipment feels like a native part of your smart home.\n",
        "da": "MQTT Bridge spejler stille og roligt beskeder mellem to MQTT-brokere, så enheder og tjenester uden for Homeys økosystem, som fx en overvågningsenhed til en solcelleinverter, kan tale sammen med dine Flows i realtid. Beskeder sendes i begge retninger ud fra topic-regler du selv bestemmer, så kun den data du er interesseret i krydser over, og en indbygget sikkerhedsmekanisme forhindrer de to brokere i at tale i munden på hinanden i en uendelig løkke.\n\nNår forbindelsen er oprettet, bliver værdier udgivet på den anden broker øjeblikkeligt tilgængelige for Homey Flows, og Flows kan sende værdier direkte tilbage, så din energimåler eller andet MQTT-udstyr føles som en naturlig del af dit smarte hjem.\n"
      },
      "description": {
        "en": "Keep every MQTT broker on your network perfectly in sync.",
        "da": "Hold alle dine MQTT-brokere perfekt synkroniseret."
      },
      "category": "tools",
      "brandColor": "#3B6EA5",
      "icon": "https://apps.homeycdn.net/app/com.drchip666.mqttbridge/5/45c826ed-4dfd-4a04-bb1d-5c18d1975e2c/assets/icon.svg",
      "imageSmall": "https://apps.homeycdn.net/app/com.drchip666.mqttbridge/5/45c826ed-4dfd-4a04-bb1d-5c18d1975e2c/assets/images/small.png",
      "imageLarge": "https://apps.homeycdn.net/app/com.drchip666.mqttbridge/5/45c826ed-4dfd-4a04-bb1d-5c18d1975e2c/assets/images/large.png",
      "drivers": null,
      "flow": {
        "triggers": [
