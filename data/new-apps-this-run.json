      "flow": {
        "triggers": [
          {
            "id": "grid_direction_changed",
            "title": {
              "en": "Grid direction changed",
              "da": "Netretning ændret"
            },
            "titleFormatted": {
              "en": "Grid direction changed to [[direction]]",
              "da": "Netretning ændret til [[direction]]"
            },
            "hint": {
              "en": "Triggers when the site switches between importing and exporting grid power.",
              "da": "Udløses når anlægget skifter mellem at importere og eksportere strøm fra nettet."
            },
            "args": [
              {
                "type": "device",
                "name": "device",
                "filter": "driver_id=site"
              }
            ],
            "tokens": [
              {
                "name": "direction",
                "type": "string",
                "title": {
                  "en": "Direction",
                  "da": "Retning"
                },
                "example": {
                  "en": "import",
                  "da": "import"
                }
              }
            ]
          }
        ],
        "conditions": [
          {
            "id": "battery_soc_above",
            "title": {
              "en": "Battery !{{is|isn't}} above",
              "da": "Batteri !{{er|er ikke}} over"
            },
            "titleFormatted": {
              "en": "Battery !{{is|isn't}} above [[percentage]] %",
              "da": "Batteri !{{er|er ikke}} over [[percentage]] %"
            },
            "args": [
              {
                "type": "device",
                "name": "device",
                "filter": "driver_id=site"
              },
              {
                "type": "number",
                "name": "percentage",
                "title": {
                  "en": "Percentage",
                  "da": "Procent"
                },
                "min": 0,
                "max": 100,
                "step": 1,
                "placeholder": {
                  "en": "50",
                  "da": "50"
                }
              }
            ]
          }
        ],
        "actions": [
          {
            "id": "send_command",
            "title": {
              "en": "Send a custom command",
              "da": "Send en brugerdefineret kommando"
            },
            "titleFormatted": {
              "en": "Send [[topic]] = [[value]]",
              "da": "Send [[topic]] = [[value]]"
            },
            "hint": {
              "en": "Advanced: write any topic/value pair directly to the inverter, e.g. topic 'inverter_1/output_source_priority' with value 'Utility first'.",
              "da": "Avanceret: skriv et vilkårligt topic/værdi-par direkte til inverteren, fx topic 'inverter_1/output_source_priority' med værdien 'Utility first'."
            },
            "args": [
              {
                "type": "device",
                "name": "device",
                "filter": "driver_id=site"
              },
              {
                "type": "text",
                "name": "topic",
                "title": {
                  "en": "Topic",
                  "da": "Topic"
                },
                "placeholder": {
                  "en": "inverter_1/output_source_priority",
                  "da": "inverter_1/output_source_priority"
                }
              },
              {
                "type": "text",
                "name": "value",
                "title": {
                  "en": "Value",
                  "da": "Værdi"
                },
                "placeholder": {
                  "en": "Utility first",
                  "da": "Utility first"
                }
              }
            ]
          },
          {
            "id": "set_output_source_priority",
            "title": {
              "en": "Set output source priority",
              "da": "Skift output source priority"
            },
            "titleFormatted": {
              "en": "Set output source priority to [[priority]]",
              "da": "Skift output source priority til [[priority]]"
            },
            "args": [
              {
                "type": "device",
                "name": "device",
                "filter": "driver_id=site"
              },
              {
                "type": "dropdown",
                "name": "priority",
                "title": {
                  "en": "Priority",
                  "da": "Prioritet"
                },
                "values": [
                  {
                    "id": "Utility first",
                    "label": {
                      "en": "Utility first",
                      "da": "Utility first"
                    }
                  },
                  {
                    "id": "Solar first",
                    "label": {
                      "en": "Solar first",
                      "da": "Solar first"
                    }
                  },
                  {
                    "id": "SBU",
                    "label": {
                      "en": "SBU",
                      "da": "SBU"
                    }
                  }
                ]
              }
            ]
          }
        ]
