                "da": "Ventilatorhastighed"
              },
              "preventInsights": false,
              "min": 0,
              "max": 100,
              "step": 25,
              "decimals": 0,
              "setable": false,
              "uiComponent": null
            }
          },
          "imageSmall": "https://apps.homeycdn.net/app/dk.hye-knudsen.thermexwifihood/4/8bd93005-e897-4185-9dff-572aadf174f9/drivers/thermex_hood/assets/images/small.png",
          "imageLarge": "https://apps.homeycdn.net/app/dk.hye-knudsen.thermexwifihood/4/8bd93005-e897-4185-9dff-572aadf174f9/drivers/thermex_hood/assets/images/large.png",
