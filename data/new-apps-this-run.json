                  {
                    "id": "minutes",
                    "label": {
                      "en": "minutes",
                      "da": "minutter"
                    }
                  }
                ]
              }
            ]
          }
        ],
        "conditions": [
          {
            "id": "filter_cleaning_due",
            "title": {
              "en": "The filter !{{needs|does not need}} cleaning",
              "da": "Filteret !{{skal|skal ikke}} renses"
            },
            "hint": {
              "en": "True when accumulated weighted fan hours have reached the cleaning interval in Advanced settings. Remains true until reset or the limit is raised above accumulated use.",
              "da": "Sand, når den vægtede ventilatortid har nået renseintervallet i Avancerede indstillinger. Forbliver sand indtil nulstilling, eller indtil grænsen hæves over den optjente tid."
            },
            "args": [
              {
                "type": "device",
                "name": "device",
                "filter": "driver_id=thermex_hood"
              }
            ]
          },
          {
            "id": "fan_speed_above_percentage",
            "title": {
              "en": "Fan speed !{{is|is not}} above a percentage",
              "da": "Ventilatorhastigheden !{{er|er ikke}} over en procentværdi"
            },
            "titleFormatted": {
              "en": "Fan speed !{{is|is not}} above [[percentage]]%",
              "da": "Ventilatorhastigheden !{{er|er ikke}} over [[percentage]] %"
            },
            "hint": {
              "en": "Checks the current fan speed. Equal percentages do not count as above. Above 0% means the fan is on.",
              "da": "Kontrollerer den aktuelle ventilatorhastighed. Samme procentværdi tæller ikke som over. Over 0 % betyder, at ventilatoren er tændt."
            },
            "args": [
              {
                "type": "device",
                "name": "device",
                "filter": "driver_id=thermex_hood"
              },
              {
                "name": "percentage",
                "type": "number",
                "title": {
                  "en": "Percentage",
                  "da": "Procent"
                },
                "min": 0,
                "max": 100,
                "step": 1,
                "placeholder": {
                  "en": "0-100",
                  "da": "0-100"
                }
              }
            ]
          },
          {
            "id": "light_brightness_above_percentage",
            "title": {
              "en": "Light brightness !{{is|is not}} above a percentage",
              "da": "Lysstyrken !{{er|er ikke}} over en procentværdi"
            },
            "titleFormatted": {
              "en": "Light brightness !{{is|is not}} above [[percentage]]%",
              "da": "Lysstyrken !{{er|er ikke}} over [[percentage]] %"
            },
            "hint": {
              "en": "Checks the current light brightness. Equal percentages do not count as above. Above 0% means the light is on.",
              "da": "Kontrollerer den aktuelle lysstyrke. Samme procentværdi tæller ikke som over. Over 0 % betyder, at lyset er tændt."
            },
            "args": [
              {
                "type": "device",
                "name": "device",
                "filter": "driver_id=thermex_hood"
              },
              {
                "name": "percentage",
                "type": "number",
                "title": {
                  "en": "Percentage",
                  "da": "Procent"
                },
                "min": 0,
                "max": 100,
                "step": 1,
                "placeholder": {
                  "en": "0-100",
                  "da": "0-100"
                }
              }
            ]
          }
        ],
        "actions": [
          {
            "id": "reset_filter_counter",
            "title": {
              "en": "Reset the filter cleaning counter",
              "da": "Nulstil tælleren for filterrensning"
            },
            "hint": {
              "en": "Use after cleaning the filter. Clears accumulated weighted fan hours and starts a new cleaning interval, even if the fan is running.",
              "da": "Bruges efter rensning af filteret. Nulstiller den vægtede ventilatortid og starter et nyt renseinterval, også når ventilatoren kører."
            },
            "args": [
              {
                "type": "device",
                "name": "device",
                "filter": "driver_id=thermex_hood"
              }
            ]
          },
          {
            "id": "set_fan_speed_percentage",
            "title": {
              "en": "Set fan speed",
              "da": "Indstil ventilatorhastighed"
            },
            "titleFormatted": {
              "en": "Set fan speed to [[percentage]]%",
              "da": "Indstil ventilatorhastigheden til [[percentage]] %"
            },
            "hint": {
              "en": "Choose 0, 25, 50, 75 or 100%. 0% turns the fan off.",
              "da": "Vælg 0, 25, 50, 75 eller 100 %. 0 % slukker ventilatoren."
            },
            "args": [
              {
                "type": "device",
                "name": "device",
                "filter": "driver_id=thermex_hood"
              },
              {
                "name": "percentage",
                "type": "number",
                "title": {
                  "en": "Percentage",
                  "da": "Procent"
                },
                "min": 0,
                "max": 100,
                "step": 25,
                "placeholder": {
                  "en": "0, 25, 50, 75, 100",
                  "da": "0, 25, 50, 75, 100"
                }
              }
            ]
          },
          {
            "id": "set_light_brightness_percentage",
            "title": {
              "en": "Set light brightness",
              "da": "Indstil lysstyrke"
            },
            "titleFormatted": {
              "en": "Set light brightness to [[percentage]]%",
              "da": "Indstil lysstyrken til [[percentage]] %"
            },
            "hint": {
              "en": "0% turns the light off. A higher percentage turns it on at that brightness.",
              "da": "0 % slukker lyset. En højere procentværdi tænder lyset med den valgte lysstyrke."
            },
            "args": [
              {
                "type": "device",
                "name": "device",
                "filter": "driver_id=thermex_hood"
              },
              {
                "name": "percentage",
