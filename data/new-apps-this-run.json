[
  {
    "id": "com.kircuvaloglu.macmonitor",
    "rating": null,
    "liveBuild": {
      "id": 3,
      "name": {
        "en": "Mac Monitor"
      },
      "version": "1.5.2",
      "readme": {
        "en": "Your Mac mini does a lot of quiet work in the background, and now your home can keep an eye on it. See at a glance how hot it runs, how busy it is and how much disk space is left, and get a nudge when something needs attention, like a full disk or a missed backup.\n\nLet your Mac take part in your Flows as well: dim the lights when you walk away from it, keep it awake while a download finishes, put it to sleep at night and wake it again in the morning. A small helper runs on each Mac, and everything stays on your own network.\n"
      },
      "description": {
        "en": "Keep your Mac cool, healthy and part of your home"
      },
      "category": "tools",
      "brandColor": "#38D6E0",
      "icon": "https://apps.homeycdn.net/app/com.kircuvaloglu.macmonitor/3/ab05e193-5cd7-45cb-880d-d4c4f0619293/assets/icon.svg",
      "imageSmall": "https://apps.homeycdn.net/app/com.kircuvaloglu.macmonitor/3/ab05e193-5cd7-45cb-880d-d4c4f0619293/assets/images/small.png",
      "imageLarge": "https://apps.homeycdn.net/app/com.kircuvaloglu.macmonitor/3/ab05e193-5cd7-45cb-880d-d4c4f0619293/assets/images/large.png",
      "drivers": [
