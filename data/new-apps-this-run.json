    "liveBuild": {
      "id": 2,
      "name": {
        "en": "Wiener Netze Smart Meter"
      },
      "version": "2.11.2",
      "readme": {
        "en": "Bring your Wiener Netze smart meter into Homey. The app signs in to your Smart Meter portal account, discovers every Zaehlpunkt on it, and adds each one as a device so yesterday's consumption and meter reading land right next to the rest of your home.\n\nThe values arrive as standard energy capabilities, so they flow straight into Homey Energy and into any Flow you build. Get notified when a fresh reading comes in, react to a day's usage, or just keep a quiet eye on where your kilowatt-hours go. Set up once and it keeps itself up to date.\n"
      },
      "description": {
        "en": "Keep an eye on your energy use.",
        "de": "Behalte deinen Energieverbrauch im Blick."
      },
      "category": "energy",
      "brandColor": "#bb005d",
      "icon": "https://apps.homeycdn.net/app/at.dsnet.wnsm/2/07fbb09b-57c6-4e97-96d3-513271971245/assets/icon.svg",
      "imageSmall": "https://apps.homeycdn.net/app/at.dsnet.wnsm/2/07fbb09b-57c6-4e97-96d3-513271971245/assets/images/small.png",
      "imageLarge": "https://apps.homeycdn.net/app/at.dsnet.wnsm/2/07fbb09b-57c6-4e97-96d3-513271971245/assets/images/large.png",
      "drivers": [
        {
          "id": "smartmeter",
          "name": {
            "en": "Wiener Netze Smart Meter"
          },
          "class": "sensor",
          "capabilities": [
            "meter_power",
            "meter_power.daily"
          ],
          "capabilitiesOptions": {
            "meter_power": {
              "title": {
                "en": "Meter reading (yesterday)",
                "de": "Zählerstand (gestern)"
              }
            },
            "meter_power.daily": {
              "title": {
                "en": "Daily consumption (yesterday)",
                "de": "Tagesverbrauch (gestern)"
              }
            }
          },
          "energy": {
            "cumulative": true,
            "cumulativeImportedCapability": "meter_power"
          },
          "imageSmall": "https://apps.homeycdn.net/app/at.dsnet.wnsm/2/07fbb09b-57c6-4e97-96d3-513271971245/drivers/smartmeter/assets/images/small.png",
          "imageLarge": "https://apps.homeycdn.net/app/at.dsnet.wnsm/2/07fbb09b-57c6-4e97-96d3-513271971245/drivers/smartmeter/assets/images/large.png",
          "platforms": [
            "local"
          ],
          "connectivity": [
            "cloud"
          ],
          "icon": "https://apps.homeycdn.net/app/at.dsnet.wnsm/2/07fbb09b-57c6-4e97-96d3-513271971245/drivers/smartmeter/assets/icon.svg"
        }
      ],
      "flow": {
