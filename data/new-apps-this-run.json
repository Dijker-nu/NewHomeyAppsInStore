                      "en": "milliseconds",
                      "nl": "milliseconden",
                      "fr": "millisecondes"
                    }
                  },
                  {
                    "id": "seconds",
                    "title": {
                      "en": "seconds",
                      "nl": "seconden",
                      "fr": "secondes"
                    }
                  }
                ]
              }
            ]
          }
        ],
