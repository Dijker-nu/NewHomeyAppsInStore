  {
    "id": "com.thermia",
    "rating": null,
    "liveBuild": {
      "id": 2,
      "name": {
        "en": "Thermia Heat Pump",
        "nl": "Thermia Warmtepomp"
      },
      "version": "1.0.1",
      "readme": {
        "en": "Keep an eye on your Thermia heat pump and control it from Homey, entirely locally and without the cloud. Switch heating and hot water on or off, adjust the temperature, follow what the heat pump is doing right now and see how much energy it uses for heating, hot water and cooling.\n\nEnable Modbus TCP/IP on the heat pump (Settings / BMS on the display), connect it to your network and add it in Homey with its IP address. Is your heat pump missing a room sensor or power meter? Feed those values in from other devices with Flow. This app is not affiliated with or endorsed by Thermia AB.\n",
        "nl": "Houd je Thermia warmtepomp in de gaten en bedien hem vanuit Homey, volledig lokaal en zonder cloud. Zet verwarming en warm water aan of uit, pas de temperatuur aan, zie wat de warmtepomp op dit moment doet en bekijk hoeveel energie hij verbruikt voor verwarmen, warm water en koelen.\n\nSchakel Modbus TCP/IP in op de warmtepomp (Settings / BMS op het display), verbind hem met je netwerk en voeg hem toe in Homey met zijn IP-adres. Mist je warmtepomp een kamersensor of vermogensmeter? Voer die waarden dan in vanuit andere apparaten met Flow. Deze app is niet gelieerd aan of goedgekeurd door Thermia AB.\n"
      },
      "description": {
        "en": "Sustainable comfort, smartly controlled",
        "nl": "Duurzaam comfort, slim geregeld"
      },
      "category": "climate",
      "brandColor": "#E8622C",
      "icon": "https://apps.homeycdn.net/app/com.thermia/2/62fab0b0-778a-43b0-9f05-2b2db962b81c/assets/icon.svg",
      "imageSmall": "https://apps.homeycdn.net/app/com.thermia/2/62fab0b0-778a-43b0-9f05-2b2db962b81c/assets/images/small.jpg",
      "imageLarge": "https://apps.homeycdn.net/app/com.thermia/2/62fab0b0-778a-43b0-9f05-2b2db962b81c/assets/images/large.jpg",
