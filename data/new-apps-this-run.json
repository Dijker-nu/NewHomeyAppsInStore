                "min": 1,
                "step": 1,
                "title": {
                  "en": "Duration",
                  "nl": "Duur",
                  "fr": "Durée"
                },
                "placeholder": {
                  "en": "e.g. 500",
                  "nl": "Bijv. 500",
                  "fr": "Par ex. 500"
                }
              },
              {
