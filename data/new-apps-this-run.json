  {
    "id": "com.evcharging.predictor",
    "rating": null,
    "liveBuild": {
      "id": 5,
      "name": {
        "en": "EV Charging Predictor"
      },
      "version": "1.4.6",
      "readme": {
        "en": "EV Charging Predictor learns when your car leaves, when it comes home and how much energy it needs, just from your EV charger. Pair it with your existing charger and it picks up your weekly routine from when the cable is plugged in and out. It runs entirely on your Homey: it only reads your charger, and nothing leaves your home.\n\nUse the predictions in your own Flows, for example to make sure the car is charged by the time you leave, or to skip a charging plan when it barely needs a top-up. Easee chargers give real predictions from day one; other chargers learn in one to two weeks.\n",
        "nl": "EV Charging Predictor leert wanneer je auto vertrekt, wanneer hij weer thuiskomt en hoeveel energie hij nodig heeft, gewoon via je laadpaal. Koppel de app aan je bestaande laadpaal en hij leert je weekritme aan de hand van wanneer de kabel in- en uitgeplugd wordt. Alles draait op je Homey: de app leest alleen je laadpaal uit, en er verlaat niets je huis.\n\nGebruik de voorspellingen in je eigen Flows, bijvoorbeeld om de auto vol te hebben als je vertrekt, of om een laadplan over te slaan als hij nauwelijks bijgeladen hoeft te worden. Easee-laadpalen geven vanaf dag één echte voorspellingen; andere laadpalen leren in één à twee weken.\n"
      },
      "description": {
        "en": "Learns when your car leaves, comes home and how much energy it needs, all from your EV charger."
      },
      "category": "energy",
      "brandColor": "#2e7d32",
      "icon": "https://apps.homeycdn.net/app/com.evcharging.predictor/5/efeaf41a-c2e7-41c5-9355-6a43c0f80d7c/assets/icon.svg",
      "imageSmall": "https://apps.homeycdn.net/app/com.evcharging.predictor/5/efeaf41a-c2e7-41c5-9355-6a43c0f80d7c/assets/images/small.png",
      "imageLarge": "https://apps.homeycdn.net/app/com.evcharging.predictor/5/efeaf41a-c2e7-41c5-9355-6a43c0f80d7c/assets/images/large.png",
      "drivers": [
        {
          "id": "ev_charging_predictor",
          "name": {
            "en": "EV Charging Predictor"
          },
          "class": "sensor",
          "capabilities": [
            "prediction_status",
            "car_present",
            "predicted_departure_time",
            "predicted_departure_minutes",
            "predicted_departure_confidence",
            "predicted_arrival_time",
            "predicted_arrival_minutes",
            "predicted_arrival_confidence",
            "predicted_charge_kwh"
          ],
          "imageSmall": "https://apps.homeycdn.net/app/com.evcharging.predictor/5/efeaf41a-c2e7-41c5-9355-6a43c0f80d7c/drivers/ev_charging_predictor/assets/images/small.png",
          "imageLarge": "https://apps.homeycdn.net/app/com.evcharging.predictor/5/efeaf41a-c2e7-41c5-9355-6a43c0f80d7c/drivers/ev_charging_predictor/assets/images/large.png",
          "platforms": [
            "local"
          ],
          "icon": "https://apps.homeycdn.net/app/com.evcharging.predictor/5/efeaf41a-c2e7-41c5-9355-6a43c0f80d7c/drivers/ev_charging_predictor/assets/icon.svg",
          "connectivity": null
        }
      ],
      "flow": {
        "triggers": [
          {
            "id": "arrival_predicted_within",
            "title": {
              "en": "Arrival predicted within a time"
            },
            "titleFormatted": {
              "en": "Arrival predicted within [[minutes]] minutes"
            },
            "hint": {
              "en": "Fires once when the predicted minutes-until-arrival first drops to or below the given value for a newly predicted arrival."
            },
            "args": [
              {
                "type": "device",
                "name": "device",
                "filter": "driver_id=ev_charging_predictor"
              },
              {
                "type": "number",
                "name": "minutes",
                "title": {
                  "en": "minutes"
                },
                "min": 1,
                "placeholder": {
                  "en": "60"
                }
              }
            ],
            "tokens": [
              {
                "name": "minutes",
                "type": "number",
                "title": {
                  "en": "Minutes until arrival"
                },
                "example": 45
              },
              {
                "name": "confidence",
                "type": "number",
                "title": {
                  "en": "Confidence"
                },
                "example": 72
              },
              {
                "name": "predictedTime",
                "type": "string",
                "title": {
                  "en": "Predicted time"
                },
                "example": "18:05"
              }
            ]
          },
          {
            "id": "charge_need_updated",
            "title": {
              "en": "The predicted daily charge need changed"
            },
            "hint": {
              "en": "Fires when the expected energy the car needs on the coming day changes by at least 0.5 kWh. The estimate is conditioned on that day's weekday, so weekly patterns show. The tokens include a low/high band (10th-90th percentile) you can use as a safety margin in energy Flows."
            },
            "args": [
              {
                "type": "device",
                "name": "device",
                "filter": "driver_id=ev_charging_predictor"
              }
            ],
            "tokens": [
              {
                "name": "expectedKwh",
                "type": "number",
                "title": {
                  "en": "Expected daily need (kWh)"
                },
                "example": 11.4
              },
              {
                "name": "lowKwh",
                "type": "number",
