  {
    "id": "com.alpha.mohlenhoff.v2",
    "rating": null,
    "liveBuild": {
      "id": 13,
      "name": {
        "en": "Alpha Möhlenhoff V2",
        "nl": "Alpha Möhlenhoff V2"
      },
      "version": "0.1.10",
      "readme": {
        "en": "This app connects your Alpha Möhlenhoff (EZR) heating controller to Homey over your local network, so you can see and adjust the temperature in every room straight from the Homey app.\n\nThermostats are found automatically once you enter the controller's IP address during pairing. All communication stays on your own network, so no cloud account is required.\n",
        "nl": "Deze app koppelt je Alpha Möhlenhoff (EZR) verwarmingsregelaar via je lokale netwerk aan Homey, zodat je de temperatuur van elke kamer rechtstreeks vanuit de Homey-app kunt bekijken en aanpassen.\n\nThermostaten worden automatisch gevonden zodra je tijdens het koppelen het IP-adres van de controller invoert. Alle communicatie blijft binnen je eigen netwerk, dus er is geen cloudaccount nodig.\n"
      },
      "description": {
        "en": "The comfort of every room, exactly where you want it.",
        "nl": "Het comfort van elke kamer, precies zoals jij het wilt."
      },
      "category": "climate",
      "brandColor": "#b7253b",
      "icon": "https://apps.homeycdn.net/app/com.alpha.mohlenhoff.v2/13/40e3c361-214a-41d2-ba51-2507d14dfd2a/assets/icon.svg",
