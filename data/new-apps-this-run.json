  {
    "id": "zyxel.router",
    "rating": null,
    "liveBuild": {
      "id": 12,
      "name": {
        "en": "Zyxel Router",
        "nl": "Zyxel Router"
      },
      "version": "1.2.4",
      "readme": {
        "en": "Connect your Homey Pro to your Zyxel NR5307 5G router and keep track of your network at a glance. Monitor cellular signal strength, view connected devices, and access key router metrics—all from your Homey dashboard. Perfect for automating actions based on connection quality or device activity.\nIt may work with other Zyxel router models using similar firmware (e.g., NR7101, NR5103, NR5307, NR5101, NR5309, NR5111, NR2301 and NR7302), but compatibility is not tested.",
        "nl": "Verbind je Homey Pro met je Zyxel NR5307 5G-router en houd je netwerk in de gaten. Monitor de mobiele signaalsterkte, bekijk verbonden apparaten en toegang tot belangrijke router-gegevens—allemaal vanaf je Homey-dashboard. Ideaal voor het automatiseren van acties op basis van verbindingskwaliteit of apparaatactiviteit.\nMogelijk werkt deze app ook met andere Zyxel router modellen met dezelfde firmware (bijvoorbeeld; NR7101, NR5103, NR5307, NR5101, NR5309, NR5111, NR2301 en NR7302), dit is niet getest."
      },
      "description": {
        "en": "Your 5G connection at a glance",
        "nl": "Je 5G-verbinding in één oogopslag"
      },
      "category": "internet",
      "brandColor": "#66CC33",
      "icon": "https://apps.homeycdn.net/app/zyxel.router/12/b562bfe4-991b-41ea-b6ae-3211bddbbd24/assets/icon.svg",
      "imageSmall": "https://apps.homeycdn.net/app/zyxel.router/12/b562bfe4-991b-41ea-b6ae-3211bddbbd24/assets/images/small.png",
      "imageLarge": "https://apps.homeycdn.net/app/zyxel.router/12/b562bfe4-991b-41ea-b6ae-3211bddbbd24/assets/images/large.png",
      "drivers": [
        {
          "id": "nr5307",
          "name": {
            "en": "Zyxel NR5307",
            "nl": "Zyxel NR5307"
          },
          "class": "other",
          "capabilities": [
            "measure_signal_strength",
            "firewall_status",
            "sw_version",
            "wifi_2_4_1_name",
            "wifi_2_4_1_channel",
            "wifi_2_4_2_name",
            "wifi_2_4_2_channel",
            "wifi_5_1_name",
            "wifi_5_1_channel",
            "wifi_5_2_name",
            "wifi_5_2_channel",
            "measure_signal_rsrp",
            "measure_signal_rsrq",
            "measure_signal_rssi",
            "measure_signal_sinr",
            "measure_signal_nr_sinr",
            "measure_signal_nr_rsrp",
            "connected_devices_count",
            "measure_data_sent",
            "measure_data_received",
            "measure_data_month",
            "measure_bandwidth_down",
            "measure_bandwidth_up",
            "measure_latency",
            "ip_address_wan",
            "ip_address_lan",
            "router_uptime",
            "status_wan",
            "network_technology",
            "cell_bands"
          ],
          "capabilitiesOptions": {
            "connected_devices_count": {
              "title": {
                "en": "Connected Devices",
                "nl": "Verbonden Apparaten"
              }
            }
          },
          "imageSmall": "https://apps.homeycdn.net/app/zyxel.router/12/b562bfe4-991b-41ea-b6ae-3211bddbbd24/drivers/nr5307/assets/images/small.png",
          "imageLarge": "https://apps.homeycdn.net/app/zyxel.router/12/b562bfe4-991b-41ea-b6ae-3211bddbbd24/drivers/nr5307/assets/images/large.png",
          "platforms": [
            "local"
          ],
          "icon": "https://apps.homeycdn.net/app/zyxel.router/12/b562bfe4-991b-41ea-b6ae-3211bddbbd24/drivers/nr5307/assets/icon.svg",
          "connectivity": null
        }
      ],
      "flow": {
        "triggers": [
          {
            "id": "connected_devices_list_updated",
            "title": {
              "en": "Connected devices list updated",
              "nl": "Lijst met verbonden apparaten bijgewerkt"
            },
            "args": [
              {
                "type": "device",
                "name": "device",
                "filter": "driver_id=nr5307"
              }
            ],
            "tokens": [
              {
                "name": "device_count",
                "type": "number",
                "title": {
                  "en": "Device Count",
                  "nl": "Aantal apparaten"
                },
                "example": "18"
              },
              {
                "name": "device_list",
                "type": "string",
                "title": {
                  "en": "Device List",
                  "nl": "Lijst met apparaten"
                },
                "example": "iPhone, Laptop, Tablet"
              },
              {
                "name": "device_details",
                "type": "string",
                "title": {
                  "en": "Device detailed List",
                  "nl": "Gedetailleerde lijst met apparaten"
                },
                "example": "[{\"name\":\"iPhone\",\"mac\":\"AA:BB:CC:DD:EE:FF\",\"ip\":\"192.168.8.10\",\"connection\":\"WiFi\"}]"
              }
            ]
          },
          {
            "id": "data_limit_exceeded",
            "title": {
              "en": "Monthly data limit exceeded",
              "nl": "Maandelijkse datalimiet overschreden"
            },
            "args": [
              {
                "type": "device",
                "name": "device",
                "filter": "driver_id=nr5307"
              }
            ],
            "tokens": [
              {
                "name": "used_gb",
                "type": "number",
                "title": {
                  "en": "Data used (GB)",
                  "nl": "Dataverbruik (GB)"
                },
                "example": 105.3
              },
              {
                "name": "limit_gb",
                "type": "number",
                "title": {
                  "en": "Data limit (GB)",
                  "nl": "Datalimiet (GB)"
                },
                "example": 100
              }
            ]
          },
          {
            "id": "device_connected",
            "title": {
              "en": "Device connected",
              "nl": "Apparaat verbonden"
            },
            "args": [
              {
                "type": "device",
                "name": "device",
                "filter": "driver_id=nr5307"
              }
            ],
            "tokens": [
              {
                "name": "device_name",
                "type": "string",
                "title": {
                  "en": "Device Name",
                  "nl": "Apparaatnaam"
                },
                "example": "iPhone"
              },
              {
                "name": "device_mac",
                "type": "string",
                "title": {
                  "en": "MAC Address",
                  "nl": "MAC-adres"
                },
                "example": "AA:BB:CC:DD:EE:FF"
              }
            ]
          },
          {
            "id": "device_disconnected",
            "title": {
              "en": "Device disconnected",
              "nl": "Apparaat verbroken"
            },
            "args": [
              {
                "type": "device",
                "name": "device",
                "filter": "driver_id=nr5307"
              }
            ],
            "tokens": [
              {
                "name": "device_name",
                "type": "string",
                "title": {
                  "en": "Device Name",
                  "nl": "Apparaatnaam"
                },
                "example": "iPhone"
              },
              {
                "name": "device_mac",
                "type": "string",
                "title": {
                  "en": "MAC Address",
                  "nl": "MAC-adres"
                },
                "example": "AA:BB:CC:DD:EE:FF"
              }
            ]
          },
          {
            "id": "network_technology_changed",
            "title": {
              "en": "Network technology changed",
              "nl": "Netwerktechniek gewijzigd"
            },
            "hint": {
              "en": "Fires when switching between e.g. LTE and 5G",
              "nl": "Gaat af bij een wissel tussen bijv. LTE en 5G"
            },
            "args": [
              {
                "type": "device",
                "name": "device",
                "filter": "driver_id=nr5307"
              }
            ],
            "tokens": [
              {
                "name": "technology",
                "type": "string",
                "title": {
                  "en": "Technology",
                  "nl": "Techniek"
                },
                "example": "NR5G+"
              },
              {
                "name": "previous",
                "type": "string",
                "title": {
                  "en": "Previous technology",
                  "nl": "Vorige techniek"
                },
                "example": "LTE"
              },
              {
                "name": "bands",
                "type": "string",
                "title": {
                  "en": "Active bands",
                  "nl": "Actieve banden"
                },
                "example": "B3+B7 / N78"
              }
            ]
          },
          {
            "id": "signal_strength_changed",
            "title": {
              "en": "Signal strength changed",
              "nl": "Signaalsterkte gewijzigd"
            },
            "args": [
              {
                "type": "device",
                "name": "device",
                "filter": "driver_id=nr5307"
              }
            ],
            "tokens": [
              {
                "name": "signalValue",
                "type": "number",
                "title": {
                  "en": "Signal Strength (%)",
                  "nl": "Signaalsterkte (%)"
                },
                "example": 60
              }
            ]
          },
          {
            "id": "wan_connected_status",
            "title": {
              "en": "Connection status changed",
              "nl": "Verbindingsstatus gewijzigd"
            },
            "args": [
              {
                "type": "device",
                "name": "device",
                "filter": "driver_id=nr5307"
              }
            ],
            "tokens": [
              {
                "name": "wanSt",
                "type": "string",
                "title": {
                  "en": "WAN status",
                  "nl": "WAN status"
                },
                "example": "Up & Up"
              }
            ]
          }
        ],
        "conditions": [
          {
            "id": "latency_below",
            "title": {
              "en": "Latency !{{is|is not}} below",
              "nl": "Latentie !{{is|is niet}} onder"
            },
            "titleFormatted": {
              "en": "Latency !{{is|is not}} below [[threshold]]",
              "nl": "Latentie !{{is|is niet}} onder [[threshold]]"
            },
            "args": [
              {
                "type": "device",
                "name": "device",
                "filter": "driver_id=nr5307"
              },
              {
                "type": "number",
                "name": "threshold",
                "title": {
                  "en": "Latency (ms)",
                  "nl": "Latentie (ms)"
                },
                "placeholder": {
                  "en": "100"
                }
              }
            ]
          },
          {
            "id": "on_5g",
            "title": {
              "en": "!{{Is|Is not}} connected via 5G",
              "nl": "!{{Is|Is niet}} verbonden via 5G"
            },
            "args": [
              {
                "type": "device",
                "name": "device",
                "filter": "driver_id=nr5307"
              }
            ]
          },
          {
            "id": "signal_quality_above",
            "title": {
              "en": "Signal quality !{{is|is not}} above threshold",
              "nl": "Signaalkwaliteit !{{is|is niet}} boven drempelwaarde"
            },
            "titleFormatted": {
              "en": "Signal quality !{{is|is not}} above [[threshold]] dBm",
              "nl": "Signaalkwaliteit !{{is|is niet}} boven [[threshold]] dBm"
            },
            "args": [
              {
                "type": "device",
                "name": "device",
                "filter": "driver_id=nr5307"
              },
              {
                "name": "threshold",
                "type": "number",
                "placeholder": {
                  "en": "-90"
                }
              }
            ]
          }
        ],
        "actions": [
          {
            "id": "reboot_router",
            "title": {
              "en": "Reboot",
              "nl": "Herstarten"
            },
            "args": [
              {
                "type": "device",
                "name": "device",
                "filter": "driver_id=nr5307"
              }
            ]
          }
        ]
      },
