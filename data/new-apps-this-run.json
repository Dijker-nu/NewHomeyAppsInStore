            "meter_power",
            "meter_power.heating",
            "meter_power.tapwater",
            "meter_power.cooling"
          ],
          "capabilitiesOptions": {
            "onoff": {
              "title": {
                "en": "Power",
                "nl": "Aan/uit"
              }
            },
            "onoff.warmwater": {
              "title": {
                "en": "Hot water",
