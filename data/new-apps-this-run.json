  {
    "id": "com.esko.themo",
    "rating": null,
    "liveBuild": {
      "id": 7,
      "name": {
        "en": "Themo"
      },
      "version": "1.0.6",
      "readme": {
        "en": "Themo keeps electric floor heating comfortable while using cheaper, greener electricity. Connect your Themo account to Homey and the thermostats in each room become part of the home you already automate.\n\nSet a temperature, switch between automatic and manual heating, or turn a room off from Homey. Themo continues to follow its own schedule in automatic mode, so floors stay warm when you need them and save energy when you do not.\n"
      },
      "description": {
        "en": "Heat your floors using affordable exchange electricity"
      },
      "category": "climate",
      "brandColor": "#52469A",
      "icon": "https://apps.homeycdn.net/app/com.esko.themo/7/c8a22da2-7133-4014-b203-30f8fbccc489/assets/icon.svg",
      "imageSmall": "https://apps.homeycdn.net/app/com.esko.themo/7/c8a22da2-7133-4014-b203-30f8fbccc489/assets/images/small.png",
      "imageLarge": "https://apps.homeycdn.net/app/com.esko.themo/7/c8a22da2-7133-4014-b203-30f8fbccc489/assets/images/large.png",
      "drivers": [
        {
          "id": "thermostat",
          "name": {
            "en": "Themo Smart Thermostat"
          },
          "class": "thermostat",
          "capabilities": [
            "measure_temperature",
            "measure_temperature.floor",
            "target_temperature",
            "thermostat_mode",
            "measure_power",
            "themo_heating",
            "themo_schedule"
          ],
          "capabilitiesOptions": {
            "measure_temperature": {
              "title": {
                "en": "Room Temperature"
              },
              "decimals": 1
            },
            "measure_temperature.floor": {
              "title": {
                "en": "Floor Temperature"
              },
              "decimals": 1
            },
            "target_temperature": {
              "min": 5,
              "max": 41,
              "step": 0.5,
              "decimals": 1
            },
            "measure_power": {
              "title": {
                "en": "Heating Power"
              },
              "decimals": 0,
              "approximated": true
            },
            "thermostat_mode": {
              "values": [
                {
                  "id": "auto",
                  "title": {
                    "en": "Automatic"
                  }
                },
                {
                  "id": "heat",
                  "title": {
                    "en": "Heat"
                  }
                },
                {
                  "id": "off",
                  "title": {
