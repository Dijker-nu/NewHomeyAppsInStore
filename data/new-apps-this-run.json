                "placeholder": {
                  "en": "60",
                  "nl": "60"
                },
                "min": 0,
                "max": 3600,
                "step": 5
              }
            ]
          },
          {
            "id": "mesh_release",
            "title": {
              "en": "Release the Bluetooth mesh",
              "nl": "Bluetooth-mesh vrijgeven"
