          },
          {
            "id": "mesh_connect",
            "title": {
              "en": "Connect to the Bluetooth mesh now",
              "nl": "Nu verbinden met het Bluetooth-mesh"
            },
            "hint": {
              "en": "Run this a moment before you switch lights (e.g. on motion), so the command does not have to wait for the Bluetooth connection.",
              "nl": "Gebruik dit vlak voordat je lampen schakelt (bijvoorbeeld bij beweging), zodat het commando niet op de Bluetooth-verbinding hoeft te wachten."
            }
          },
          {
            "id": "mesh_keepalive",
            "title": {
              "en": "Set the Bluetooth keep-alive",
              "nl": "Bluetooth keep-alive instellen"
            },
            "titleFormatted": {
              "en": "Release the lamp after [[seconds]] seconds idle",
              "nl": "Lamp vrijgeven na [[seconds]] seconden zonder activiteit"
            },
            "hint": {
              "en": "0 keeps Homey connected (instant commands). For example: 0 in the evening, 60 during the day.",
              "nl": "0 houdt Homey verbonden (directe commando's). Bijvoorbeeld: 's avonds 0, overdag 60."
            },
            "args": [
              {
                "type": "number",
