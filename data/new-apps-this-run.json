  {
    "id": "community.birdbuddy",
    "rating": null,
    "liveBuild": {
      "id": 2,
      "name": {
        "en": "Bird Buddy",
        "nl": "Bird Buddy"
      },
      "version": "1.0.1",
      "readme": {
        "en": "Know who visits your garden. Bird Buddy shows the latest visitor photo and video of your smart bird feeder on your Homey dashboard and lets your flows react as soon as a new bird stops by.\n\nLog in with the email address and password of your Bird Buddy account. Google or Facebook sign-in is not supported, so create an account with a password and invite it to your feeder in the Bird Buddy app. This app is not made or supported by Bird Buddy and can stop working if Bird Buddy changes its service.\n",
        "nl": "Weet wie er in je tuin op bezoek komt. Bird Buddy toont de laatste bezoekersfoto en video van je slimme voederhuisje op je Homey-dashboard en laat je flows reageren zodra er een nieuwe vogel langskomt.\n\nLog in met het e-mailadres en wachtwoord van je Bird Buddy-account. Inloggen met Google of Facebook wordt niet ondersteund: maak een account met wachtwoord aan en nodig dat uit voor je feeder in de Bird Buddy-app. Deze app is niet gemaakt of ondersteund door Bird Buddy en kan stoppen met werken als Bird Buddy zijn dienst aanpast.\n"
      },
      "description": {
        "en": "See every bird that visits your feeder",
        "nl": "Zie elke vogel die je voederhuisje bezoekt"
      },
      "category": "appliances",
      "brandColor": "#2E7D32",
      "icon": "https://apps.homeycdn.net/app/community.birdbuddy/2/2779aa47-7041-46b1-a1cd-07b280a38107/assets/icon.svg",
      "imageSmall": "https://apps.homeycdn.net/app/community.birdbuddy/2/2779aa47-7041-46b1-a1cd-07b280a38107/assets/images/small.png",
      "imageLarge": "https://apps.homeycdn.net/app/community.birdbuddy/2/2779aa47-7041-46b1-a1cd-07b280a38107/assets/images/large.png",
      "drivers": [
        {
          "id": "feeder",
          "name": {
            "en": "Feeder",
            "nl": "Voederhuisje"
          },
          "class": "sensor",
          "capabilities": [
            "measure_battery"
          ],
          "energy": {
            "batteries": [
              "INTERNAL"
            ]
          },
          "imageSmall": "https://apps.homeycdn.net/app/community.birdbuddy/2/2779aa47-7041-46b1-a1cd-07b280a38107/drivers/feeder/assets/images/small.png",
          "imageLarge": "https://apps.homeycdn.net/app/community.birdbuddy/2/2779aa47-7041-46b1-a1cd-07b280a38107/drivers/feeder/assets/images/large.png",
          "platforms": [
            "local"
          ],
          "connectivity": [
            "cloud"
          ],
          "icon": "https://apps.homeycdn.net/app/community.birdbuddy/2/2779aa47-7041-46b1-a1cd-07b280a38107/drivers/feeder/assets/icon.svg"
        }
      ],
      "flow": {
        "triggers": [
          {
            "id": "visitor_arrived",
            "title": {
              "en": "A new visitor arrived",
              "nl": "Er is een nieuwe bezoeker"
            },
            "hint": {
              "en": "Triggers when the feeder has a new visitor photo. Checked every 15 minutes.",
              "nl": "Gaat af als de feeder een nieuwe bezoekersfoto heeft. Wordt elke 15 minuten gecontroleerd."
            },
            "args": [
              {
                "type": "device",
                "name": "device",
                "filter": "driver_id=feeder"
              }
            ],
            "tokens": [
              {
                "name": "image",
                "type": "image",
                "title": {
                  "en": "Photo",
                  "nl": "Foto"
                }
              },
              {
                "name": "time",
                "type": "string",
                "title": {
                  "en": "Time of visit",
                  "nl": "Tijdstip bezoek"
                },
                "example": "2026-10-04T08:15:00.000Z"
              }
            ]
          }
        ],
        "conditions": [
          {
            "id": "visitor_within",
            "title": {
              "en": "A visitor came in the last few minutes",
              "nl": "Er was een bezoeker in de laatste minuten"
            },
            "titleFormatted": {
              "en": "A visitor came in the last [[minutes]] minutes",
              "nl": "Er was een bezoeker in de laatste [[minutes]] minuten"
            },
            "hint": {
              "en": "True if the feeder saw a visitor within the given number of minutes. Visitors are detected at the check interval.",
              "nl": "Waar als de feeder een bezoeker zag binnen het opgegeven aantal minuten. Bezoekers worden gezien op het controle-interval."
            },
            "args": [
              {
                "type": "device",
                "name": "device",
                "filter": "driver_id=feeder"
              },
              {
                "type": "number",
                "name": "minutes",
                "title": {
                  "en": "Minutes",
                  "nl": "Minuten"
                },
                "placeholder": {
                  "en": "60",
                  "nl": "60"
                },
                "min": 1,
                "max": 10080,
                "step": 1
              }
            ]
          }
        ],
        "actions": null
      },
      "widgets": {
        "last_visitor": {
          "name": {
            "en": "Last visitor",
            "nl": "Laatste bezoeker"
          },
          "height": "133%",
          "transparent": false,
          "api": {
