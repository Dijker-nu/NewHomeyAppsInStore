[
  {
    "id": "nl.error404.porsche",
    "rating": null,
    "liveBuild": {
      "id": 5,
      "name": {
        "en": "Porsche Connect",
        "nl": "Porsche Connect"
      },
      "version": "1.0.2",
      "readme": {
        "en": "Control and monitor recent Porsche Taycan, Macan Electric and Cayenne Electric models from Homey.\n\nFeatures:\n- Battery level, electric range and charging state\n- Climate start and stop\n- Automatic cached-status monitoring every five minutes\n- Explicit current-status refresh when you choose to wake the vehicle\n- Flow triggers when vehicle values change\n\nThis is an unofficial community integration and is not affiliated with or endorsed by Porsche AG.\n\nThe app connects directly from your Homey to Porsche services. Your Porsche password is used only during the active pairing session and is not stored. OAuth tokens are stored locally on your Homey so the connection can be refreshed.\n"
      },
      "description": {
        "en": "Vehicle status and climate control for recent Porsche Taycan, Macan Electric and Cayenne Electric models.",
        "nl": "Voertuigstatus en klimaatbediening voor recente Porsche Taycan, Macan Electric en Cayenne Electric-modellen."
      },
      "category": "climate",
      "brandColor": "#000000",
      "icon": "https://apps.homeycdn.net/app/nl.error404.porsche/5/6bcc6d8f-037e-4482-92d3-062bdb8b6a8d/assets/icon.svg",
      "imageSmall": "https://apps.homeycdn.net/app/nl.error404.porsche/5/6bcc6d8f-037e-4482-92d3-062bdb8b6a8d/assets/images/small.png",
      "imageLarge": "https://apps.homeycdn.net/app/nl.error404.porsche/5/6bcc6d8f-037e-4482-92d3-062bdb8b6a8d/assets/images/large.png",
      "drivers": [
        {
          "id": "cayenne-e4",
          "name": {
            "en": "Porsche Electric Vehicle",
            "nl": "Porsche elektrisch voertuig"
          },
          "class": "car",
          "capabilities": [
            "measure_distance.range",
            "measure_battery",
            "ev_charging_state",
            "porsche_climate_on",
            "porsche_climate_last_modified",
            "porsche_refresh_current"
          ],
          "capabilitiesOptions": {
            "measure_battery": {
              "title": {
                "en": "Battery",
                "nl": "Accu"
              },
              "decimals": 0
            },
            "measure_distance.range": {
              "title": {
                "en": "Range",
                "nl": "Actieradius"
              },
              "units": {
                "en": "km",
                "nl": "km"
              },
              "decimals": 0
            },
            "porsche_climate_on": {
              "title": {
                "en": "Climate",
                "nl": "Klimaat"
              }
            }
          },
          "energy": {
            "electricCar": true
          },
          "imageSmall": "https://apps.homeycdn.net/app/nl.error404.porsche/5/6bcc6d8f-037e-4482-92d3-062bdb8b6a8d/drivers/cayenne-e4/assets/images/small.png",
          "imageLarge": "https://apps.homeycdn.net/app/nl.error404.porsche/5/6bcc6d8f-037e-4482-92d3-062bdb8b6a8d/drivers/cayenne-e4/assets/images/large.png",
          "platforms": [
            "local"
          ],
          "connectivity": [
            "cloud"
          ],
          "icon": "https://apps.homeycdn.net/app/nl.error404.porsche/5/6bcc6d8f-037e-4482-92d3-062bdb8b6a8d/drivers/cayenne-e4/assets/icon.svg"
        }
      ],
      "flow": {
        "triggers": [
          {
            "id": "climate_state_changed",
            "title": {
              "en": "Climate status changed",
              "nl": "Klimaatstatus is gewijzigd"
            },
            "args": [
              {
                "type": "device",
                "name": "device",
                "filter": "driver_id=cayenne-e4"
              }
            ],
            "tokens": [
              {
                "name": "is_on",
                "type": "boolean",
                "title": {
                  "en": "Is on",
                  "nl": "Is aan"
                }
              },
              {
                "name": "last_modified",
                "type": "string",
                "title": {
                  "en": "Last modified",
                  "nl": "Meettijd"
                }
              },
              {
                "name": "stale",
                "type": "boolean",
                "title": {
                  "en": "Stale",
                  "nl": "Verouderd"
                }
              }
            ]
          }
        ],
        "conditions": [
          {
            "id": "climate_is_off",
            "title": {
              "en": "Climate is off",
              "nl": "Klimaat is uit"
            },
            "hint": {
              "en": "Uses last stored CLIMATIZER_STATE.isOn. Stale data keeps the value but shows a warning.",
              "nl": "Gebruikt laatste opgeslagen CLIMATIZER_STATE.isOn. Bij stale data blijft de waarde zichtbaar met waarschuwing."
            },
            "args": [
              {
                "type": "device",
                "name": "device",
                "filter": "driver_id=cayenne-e4"
              }
            ]
          },
          {
            "id": "climate_is_on",
            "title": {
              "en": "Climate is on",
              "nl": "Klimaat is aan"
            },
            "hint": {
              "en": "Uses last stored CLIMATIZER_STATE.isOn. Stale data keeps the value but shows a warning.",
              "nl": "Gebruikt laatste opgeslagen CLIMATIZER_STATE.isOn. Bij stale data blijft de waarde zichtbaar met waarschuwing."
            },
            "args": [
              {
                "type": "device",
                "name": "device",
                "filter": "driver_id=cayenne-e4"
              }
            ]
          }
        ],
        "actions": [
          {
            "id": "climate_read_stored",
            "title": {
              "en": "Read stored climate status",
              "nl": "Opgeslagen klimaatstatus ophalen"
            },
            "hint": {
              "en": "Fetches stored overview without wake-up. Respects rate limits.",
              "nl": "Haalt stored overview op zonder wake-up. Respecteert rate limits."
            },
            "args": [
              {
                "type": "device",
                "name": "device",
                "filter": "driver_id=cayenne-e4"
              }
            ]
          },
          {
            "id": "climate_start",
            "title": {
              "en": "Start climate",
              "nl": "Klimaat starten"
            },
            "hint": {
              "en": "Sends REMOTE_CLIMATIZER_START. API acceptance does not confirm the vehicle is running climate.",
              "nl": "Verstuurt REMOTE_CLIMATIZER_START. API-acceptatie bevestigt niet dat het voertuig klimaat draait."
            },
            "args": [
              {
                "type": "device",
                "name": "device",
                "filter": "driver_id=cayenne-e4"
              }
            ]
          },
          {
            "id": "climate_stop",
            "title": {
              "en": "Stop climate",
              "nl": "Klimaat stoppen"
            },
            "hint": {
              "en": "Sends REMOTE_CLIMATIZER_STOP. API acceptance does not confirm the vehicle stopped climate.",
              "nl": "Verstuurt REMOTE_CLIMATIZER_STOP. API-acceptatie bevestigt niet dat het voertuig klimaat stopte."
            },
            "args": [
              {
                "type": "device",
                "name": "device",
                "filter": "driver_id=cayenne-e4"
              }
            ]
          },
          {
            "id": "vehicle_read_current",
            "title": {
              "en": "Refresh the vehicle now",
              "nl": "Ververs het voertuig nu"
            },
            "hint": {
              "en": "Wakes the vehicle and retrieves current data. This may take up to 90 seconds.",
              "nl": "Maakt het voertuig wakker en haalt actuele gegevens op. Dit kan tot 90 seconden duren."
            },
            "args": [
              {
                "type": "device",
                "name": "device",
                "filter": "driver_id=cayenne-e4"
              }
            ]
          }
        ]
      },
      "widgets": null,
