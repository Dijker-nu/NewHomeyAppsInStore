              "title": {
                "en": "Light brightness",
                "da": "Lysstyrke"
              },
              "preventInsights": true
            },
            "fan_speed.fan": {
              "title": {
                "en": "Fan speed",
                "da": "Ventilatorhastighed"
              },
              "preventInsights": true,
              "min": 0,
              "max": 1,
              "step": 0.25,
              "decimals": 2
            },
